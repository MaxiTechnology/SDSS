# Example only. No real credentials belong here.
# The backend reads DATABASE_URL from its process environment.
# Copying this to .env does not load it automatically.
# Preferred Windows setup: run Connect cloud database.cmd in the project root.
# It saves verified credentials in the ignored backend/database.local.json file.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require
